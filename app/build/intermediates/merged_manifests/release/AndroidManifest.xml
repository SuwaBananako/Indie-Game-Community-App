<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.indiegamecommunity"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        android:maxSdkVersion="22" />

    <permission
        android:name="com.example.indiegamecommunity.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.indiegamecommunity.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.example.indiegamecommunity.IndieGameCommunityApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:extractNativeLibs="false"
        android:icon="@mipmap/biao"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/biao"
        android:supportsRtl="true"
        android:theme="@style/Theme.IndieGameCommunity" >
        <activity
            android:name="com.example.indiegamecommunity.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.indiegamecommunity.activity.LoginActivity"
            android:exported="true" />
        <activity
            android:name="com.example.indiegamecommunity.activity.RegisterActivity"
            android:exported="true" />
        <activity
            android:name="com.example.indiegamecommunity.activity.MainActivity"
            android:exported="true" />
        <activity
            android:name="com.example.indiegamecommunity.activity.PostDetailActivity"
            android:exported="true" />
        <activity
            android:name="com.example.indiegamecommunity.activity.PostEditActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.example.indiegamecommunity.activity.GameDetailActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.example.indiegamecommunity.activity.ProjectDetailActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.example.indiegamecommunity.activity.VoteDetailActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.example.indiegamecommunity.activity.CategoryDetailActivity"
            android:exported="true" />
        <activity
            android:name="com.example.indiegamecommunity.activity.AdminActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.example.indiegamecommunity.activity.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.example.indiegamecommunity.activity.PaymentActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.indiegamecommunity.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>