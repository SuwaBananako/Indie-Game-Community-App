<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/acfun_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/acfun_red">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI助手"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/acfun_text_white"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="智能推荐、回复建议、内容生成"
            android:textSize="13sp"
            android:textColor="@color/acfun_text_white"
            android:alpha="0.85"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/acfun_card">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入消息..."
            android:padding="12dp"
            android:background="@drawable/search_bg"
            android:textColor="@color/acfun_text"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:layout_marginStart="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="14sp"
            android:textColor="@color/acfun_text_white"
            android:background="@drawable/btn_search_bg"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/acfun_card">

        <Button
            android:id="@+id/btnRecommend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="游戏推荐"
            android:layout_marginEnd="6dp"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="@color/acfun_text_white"
            android:background="@drawable/btn_logout_bg"/>

        <Button
            android:id="@+id/btnReply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="回复建议"
            android:layout_marginEnd="6dp"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="@color/acfun_text_white"
            android:background="@drawable/btn_logout_bg"/>

        <Button
            android:id="@+id/btnContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="内容建议"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="@color/acfun_text_white"
            android:background="@drawable/btn_logout_bg"/>
    </LinearLayout>

</LinearLayout>