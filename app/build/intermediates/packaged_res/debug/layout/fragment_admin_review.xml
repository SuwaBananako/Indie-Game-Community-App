<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/acfun_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="待审核帖子"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/acfun_red"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:id="@+id/layoutPendingPosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/acfun_divider"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="待审核宣发"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/acfun_red"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:id="@+id/layoutPendingPromos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/acfun_divider"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="待审核众筹"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/acfun_red"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:id="@+id/layoutPendingCrowdfundings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/acfun_divider"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="待审核游戏（投票）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/acfun_red"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:id="@+id/layoutPendingVotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
