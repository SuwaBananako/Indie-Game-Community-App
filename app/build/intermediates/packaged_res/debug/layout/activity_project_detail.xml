<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/acfun_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/acfun_red"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/acfun_text_white"
            android:background="@android:color/transparent"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="项目详情"
            android:textSize="18sp"
            android:textColor="@color/acfun_text_white"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/acfun_card"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivGameIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_game_controller"
                android:scaleType="centerCrop"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal"/>

            <TextView
                android:id="@+id/tvProjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/acfun_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvCurrentAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/acfun_red"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/acfun_text"
                    android:id="@+id/tvProgress"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvTargetAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="@color/acfun_text_light"
                    android:gravity="end"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@color/acfun_divider"/>

                <View
                    android:id="@+id/viewProgressBar"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:background="@color/acfun_red"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvSupporters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/acfun_text_light"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvProjectDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/acfun_text"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:id="@+id/layoutProjectImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@color/acfun_bg"
                android:layout_marginLeft="-16dp"
                android:layout_marginRight="-16dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvCommentHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="评论"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/acfun_text"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/tvNoComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无评论，快来抢沙发~"
                android:textSize="14sp"
                android:textColor="@color/acfun_text_light"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"/>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/acfun_divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/acfun_bg"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ivCommentAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_default_avatar"
            android:scaleType="centerCrop"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/etComment"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="说点什么..."
            android:textSize="14sp"
            android:textColor="@color/acfun_text"
            android:textColorHint="@color/acfun_text_light"
            android:background="@drawable/edittext_background"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="发送"
            android:textSize="13sp"
            android:textColor="@color/acfun_text_white"
            android:background="@drawable/btn_search_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/acfun_divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@color/acfun_card"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <LinearLayout
            android:id="@+id/layoutLike"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/menu_item_bg">

            <ImageView
                android:id="@+id/ivLike"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_like_small"
                android:scaleType="centerInside"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点赞"
                android:textSize="12sp"
                android:textColor="@color/acfun_text_light"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCollect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/menu_item_bg">

            <ImageView
                android:id="@+id/ivCollect"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_collect_small"
                android:scaleType="centerInside"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收藏"
                android:textSize="12sp"
                android:textColor="@color/acfun_text_light"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/menu_item_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_share_small"
                android:scaleType="centerInside"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分享"
                android:textSize="12sp"
                android:textColor="@color/acfun_text_light"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSupport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/menu_item_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_crowdfunding_banner"
                android:scaleType="centerInside"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="支持"
                android:textSize="12sp"
                android:textColor="@color/acfun_text_light"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
