<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/acfun_card"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/tab_forum"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_bg_selector">
                <ImageView
                    android:id="@+id/iv_forum"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/x1"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tv_forum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="论坛"
                    android:textSize="10sp"
                    android:textColor="@color/tab_text_selector"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_tieba"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_bg_selector">
                <ImageView
                    android:id="@+id/iv_tieba"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/x2"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tv_tieba"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="贴吧"
                    android:textSize="10sp"
                    android:textColor="@color/tab_text_selector"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_promo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_bg_selector">
                <ImageView
                    android:id="@+id/iv_promo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/x3"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tv_promo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="宣发"
                    android:textSize="10sp"
                    android:textColor="@color/tab_text_selector"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_crowdfunding"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_bg_selector">
                <ImageView
                    android:id="@+id/iv_crowdfunding"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/x4"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tv_crowdfunding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="众筹"
                    android:textSize="10sp"
                    android:textColor="@color/tab_text_selector"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_vote"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_bg_selector">
                <ImageView
                    android:id="@+id/iv_vote"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/x5"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tv_vote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="投票"
                    android:textSize="10sp"
                    android:textColor="@color/tab_text_selector"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/tab_bg_selector">
                <ImageView
                    android:id="@+id/iv_profile"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/x6"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tv_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的"
                    android:textSize="10sp"
                    android:textColor="@color/tab_text_selector"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

        </LinearLayout>
        <!-- end bottomBar -->

    </LinearLayout>
    <!-- end inner wrapper -->

    <com.example.indiegamecommunity.view.SakuraView
        android:id="@+id/sakuraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</FrameLayout>
